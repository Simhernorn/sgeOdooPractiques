<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="esdeveniment_view_list" model="ir.ui.view">
        <field name="name">venda_entrades_segures.esdeveniment.list</field>
        <field name="model">venda_entrades_segures.esdeveniment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="data_inici"/>
                <field name="preu_base"/>
            </list>
        </field>
    </record>

    <record id="esdeveniment_view_form" model="ir.ui.view">
        <field name="name">venda_entrades_segures.esdeveniment.form</field>
        <field name="model">venda_entrades_segures.esdeveniment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="data_inici"/>
                        <field name="preu_base"/>
                    </group>
                    <notebook>
                        <page string="Tiquets">
                            <field name="tiquet_ids" readonly="1">
                                <list>
                                    <field name="codi_seguretat"/>
                                    <field name="comprador_id"/>
                                    <field name="preu_final"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="esdeveniment_action" model="ir.actions.act_window">
        <field name="name">Esdeveniments</field>
        <field name="res_model">venda_entrades_segures.esdeveniment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>