<odoo>
    <record id="view_matricula_alumne_list" model="ir.ui.view">
        <field name="name">matricula.alumne.list</field>
        <field name="model">matricula.alumne</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="nif"/>
                <field name="edat"/>
            </list>
        </field>
    </record>

    <record id="view_matricula_alumne_form" model="ir.ui.view">
        <field name="name">matricula.alumne.form</field>
        <field name="model">matricula.alumne</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="nif"/>
                        <field name="edat"/>
                    </group>
                    <notebook>
                        <page string="Inscripcions">
                            <field name="inscripcio_ids" readonly="1">
                                <list>
                                    <field name="curs_id"/>
                                    <field name="data_inscripcio"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_matricula_alumne" model="ir.actions.act_window">
        <field name="name">Alumnes</field>
        <field name="res_model">matricula.alumne</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>