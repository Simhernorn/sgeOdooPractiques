<odoo>
    <record id="view_matricula_curs_list" model="ir.ui.view">
        <field name="name">matricula.curs.list</field>
        <field name="model">matricula.curs</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="data_inici"/>
                <field name="data_fi"/>
                <field name="edat_minima"/>
                <field name="capacitat_maxima"/>
                <field name="places_ocupades"/>
                <field name="places_lliures"/>
            </list>
        </field>
    </record>

    <record id="view_matricula_curs_form" model="ir.ui.view">
        <field name="name">matricula.curs.form</field>
        <field name="model">matricula.curs</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="edat_minima"/>
                            <field name="capacitat_maxima"/>
                        </group>
                        <group>
                            <field name="data_inici"/>
                            <field name="data_fi"/>
                            <field name="places_ocupades"/>
                            <field name="places_lliures"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inscripcions">
                            <field name="inscripcio_ids" readonly="1">
                                <list>
                                    <field name="alumne_id"/>
                                    <field name="data_inscripcio"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_matricula_curs" model="ir.actions.act_window">
        <field name="name">Cursos</field>
        <field name="res_model">matricula.curs</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>