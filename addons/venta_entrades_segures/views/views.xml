<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- ESDEVENIMENT                                                 -->
    <!-- ============================================================ -->
    <record id="esdeveniment_view_list" model="ir.ui.view">
        <field name="name">venda_entrades_segures.esdeveniment.list</field>
        <field name="model">venda_entrades_segures.esdeveniment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="data_inici"/>
                <field name="preu_base"/>
            </list>
        </field>
    </record>

    <record id="esdeveniment_view_form" model="ir.ui.view">
        <field name="name">venda_entrades_segures.esdeveniment.form</field>
        <field name="model">venda_entrades_segures.esdeveniment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="data_inici"/>
                        <field name="preu_base"/>
                    </group>
                    <notebook>
                        <page string="Tiquets">
                            <field name="tiquet_ids" readonly="1">
                                <list>
                                    <field name="codi_seguretat"/>
                                    <field name="comprador_id"/>
                                    <field name="preu_final"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="esdeveniment_action" model="ir.actions.act_window">
        <field name="name">Esdeveniments</field>
        <field name="res_model">venda_entrades_segures.esdeveniment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- TIQUET                                                       -->
    <!-- ============================================================ -->
    <record id="tiquet_view_list" model="ir.ui.view">
        <field name="name">venda_entrades_segures.tiquet.list</field>
        <field name="model">venda_entrades_segures.tiquet</field>
        <field name="arch" type="xml">
            <list>
                <field name="codi_seguretat"/>
                <field name="comprador_id"/>
                <field name="esdeveniment_id"/>
                <field name="preu_final"/>
                <field name="data_limit_acces"/>
                <field name="etiquetes_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </list>
        </field>
    </record>

    <record id="tiquet_view_form" model="ir.ui.view">
        <field name="name">venda_entrades_segures.tiquet.form</field>
        <field name="model">venda_entrades_segures.tiquet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="foto_comprador" widget="image" class="oe_avatar"/>
                    <group>
                        <group string="Dades de l'entrada">
                            <field name="comprador_id"/>
                            <field name="esdeveniment_id"/>
                            <field name="etiquetes_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group string="Camps calculats">
                            <field name="preu_final"/>
                            <field name="codi_seguretat"/>
                            <field name="data_limit_acces"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clàusules legals">
                            <field name="clausules_legals" widget="html" readonly="1"/>
                        </page>
                        <page string="Entrades relacionades">
                            <field name="entrades_relacionades_ids" readonly="1">
                                <list>
                                    <field name="codi_seguretat"/>
                                    <field name="comprador_id"/>
                                    <field name="preu_final"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tiquet_action" model="ir.actions.act_window">
        <field name="name">Tiquets</field>
        <field name="res_model">venda_entrades_segures.tiquet</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- ETIQUETA                                                     -->
    <!-- ============================================================ -->
    <record id="etiqueta_action" model="ir.actions.act_window">
        <field name="name">Etiquetes</field>
        <field name="res_model">venda_entrades_segures.etiqueta</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- MENÚS (al final: necessiten les accions definides a dalt)    -->
    <!-- ============================================================ -->
    <menuitem id="menu_root" name="Entrades Segures" sequence="10"/>
    <menuitem id="menu_tiquet" name="Tiquets" parent="menu_root" action="tiquet_action" sequence="10"/>
    <menuitem id="menu_esdeveniment" name="Esdeveniments" parent="menu_root" action="esdeveniment_action" sequence="20"/>
    <menuitem id="menu_etiqueta" name="Etiquetes" parent="menu_root" action="etiqueta_action" sequence="30"/>

</odoo>