<odoo>
  <!-- Vista lista -->
  <record id="holamon_registro_view_list" model="ir.ui.view">
    <field name="name">holamon.registro.list</field>
    <field name="model">holamon.registro</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="entero"/>
        <field name="fecha"/>
        <field name="estado"/>
      </list>
    </field>
  </record>

  <!-- Vista formulario -->
  <record id="holamon_registro_view_form" model="ir.ui.view">
    <field name="name">holamon.registro.form</field>
    <field name="model">holamon.registro</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="entero"/>
              <field name="decimal"/>
              <field name="booleano"/>
              <field name="estado"/>
            </group>
            <group>
              <field name="fecha"/>
              <field name="fecha_hora"/>
              <field name="archivo"/>
              <field name="imagen" widget="image"/>
            </group>
          </group>
          <group>
            <field name="texto"/>
            <field name="contenido_html"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción de ventana -->
  <record id="holamon_action_registro" model="ir.actions.act_window">
    <field name="name">Registros</field>
    <field name="res_model">holamon.registro</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Menús -->
  <menuitem id="holamon_menu_root" name="Hola Món" sequence="10"/>
  <menuitem id="holamon_menu_registro" name="Registros"
            parent="holamon_menu_root" action="holamon_action_registro"
            sequence="10"/>
</odoo>